{
  "author": "Bahram Joharshamshiri",
  "dependencies": {
    "lungo-ts": "1.82.64",
    "peggy": "^5.1.0",
    "tagged-urn": "^1.73.7"
  },
  "description": "JavaScript implementation of Cap URN (Capability Uniform Resource Names) with strict validation and matching",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./capdag.js",
    "./cap-fab-renderer": "./cap-fab-renderer.js",
    "./machine-parser": "./machine-parser.js"
  },
  "files": [
    "capdag.js",
    "cap-fab-renderer.js",
    "build-browser.js",
    "formal/index.js",
    "formal/index.d.ts",
    "formal/program.wasm",
    "machine.pegjs",
    "machine-parser.js",
    "planner.js",
    "RULES.md",
    "README.md"
  ],
  "keywords": [
    "cap",
    "urn",
    "capability",
    "namespace",
    "validation",
    "matching"
  ],
  "license": "MIT",
  "main": "capdag.js",
  "name": "capdag",
  "repository": {
    "directory": "capdag-js",
    "type": "git",
    "url": "https://github.com/machinefabric/capdag-js.git"
  },
  "scripts": {
    "build:parser": "npx peggy --format es -o machine-parser.js machine.pegjs",
    "build:browser": "npm run build:parser && node build-browser.js",
    "pretest": "npm run build:parser",
    "test": "node capdag.test.js"
  },
  "type": "module",
  "version": "1.373.0"
}
